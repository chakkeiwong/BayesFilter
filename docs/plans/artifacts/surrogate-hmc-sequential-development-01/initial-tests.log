        variance = math.log(2.)**2
    
        @tf.function(input_signature=[tf.TensorSpec([None, 2], tf.float64)],
                     jit_compile=True, autograph=False)
        def force(x):
            return PositionOnlyForceEvaluation(x / variance, tf.ones(tf.shape(x)[:-1], tf.bool))
    
