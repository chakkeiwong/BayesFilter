# LaTeX build byproducts
*.aux
*.bbl
*.bcf
*.blg
*.dvi
*.fdb_latexmk
*.fls
*.idx
*.ilg
*.ind
*.log
*.lof
*.lol
*.lot
*.nav
*.out
*.run.xml
*.snm
*.synctex.gz
*.toc
*.vrb
*.xdv

# Generated PDF outputs; rebuild locally from the TeX sources.
/*.pdf
/docs/**/*.pdf

# Python build/test byproducts
__pycache__/
*.py[cod]
*.so
build/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Generated JSON outputs. Promotion/verification artifacts under
# docs/benchmarks remain visible when they support a retained result or claim.
*.json
!docs/benchmarks/*.json
!docs/benchmarks/**/*.json
!docs/plans/artifacts/lgssm-first-neutra-gpu-training-2026-07-07/lgssm_static_qr_exact_kalman_affine_neutra_gpu_xla_training_state_seed20260707.json
!docs/plans/artifacts/multidim-triangular-lgssm-neutra-hmc-2026-07-08/lower_triangular_lgssm_contract_v1.json
!docs/plans/artifacts/multidim-triangular-lgssm-neutra-hmc-2026-07-08/lower_triangular_lgssm_synthetic_data_v1_seed20260708.json
!docs/plans/artifacts/multidim-triangular-lgssm-neutra-hmc-2026-07-08/lower_triangular_lgssm_synthetic_data_v1_manifest_seed20260708.json

# Local benchmark execution byproducts. Keep authored harnesses, compact result
# JSON/Markdown, strict manifests, and compressed claim archives trackable.
docs/benchmarks/**/*.txt
docs/benchmarks/**/*_authorized_snapshot_*.json
docs/benchmarks/**/*_invalid_harness_archive_*.json
docs/benchmarks/**/*_pre_redteam_*.json

# Raw structural payloads are reproducible but unsuitable as Git objects. Their
# tracked .json.gz archives and result notes preserve the retained evidence.
docs/benchmarks/kalman_qr_batched_xla_repair_phase6_gateb_r3_cpu_xla_pilot_2026-07-12.json
docs/benchmarks/kalman_qr_batched_xla_repair_phase6_gateb_r3_trace_census_2026-07-12.json
docs/benchmarks/kalman_qr_batched_xla_repair_phase6_gateb_r3_autodiff_structure_localization_2026-07-13.json
docs/benchmarks/kalman_qr_batched_xla_repair_phase6_gateb_r3_autodiff_attribution_discriminator_2026-07-13.json

# Local diagnostic sidecars from benchmark/tuning runs. Public JSON/Markdown
# summaries under docs/benchmarks stay trackable when they support evidence.
docs/benchmarks/**/*_public_artifacts_*/private_diagnostics/
docs/benchmarks/**/private_diagnostics/

# Review packets and iterative transcripts are local process artifacts. Final
# or standalone reviews that support a retained gate remain trackable.
docs/reviews/**/*-bundle-*.md
docs/reviews/**/*review-bundle*.md
docs/reviews/**/*review-packet*.md
docs/reviews/**/*-request-*.md
docs/reviews/**/*round[0-9]*.md

# OS metadata from local/vendored snapshots
.DS_Store
Icon?
desktop.ini

# Local editor/tool state
.codex/
.codex_*_write_probe
.serena/
.cache/
.claude/
.claude_reviews/
.localenv/

# Agent scratch rewrite buffers. Evidence notes/results under docs/plans stay
# tracked when they support a claim, gate, or promotion decision.
.tmp_*_rewrite.tex

# Nested third-party source snapshots should be tracked as files, not embedded
# repositories.
third_party/**/.git/
.localsource/**/.git/

# Local literature workspace and downloaded papers.
.research/
local_research/
.localsource/
