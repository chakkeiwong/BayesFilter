+@lru_cache(maxsize=8)
+def _compiled_reverse_mode_oracle(time_steps: int, tf: Any, kalman_filter: Any) -> Any:
+    """Cache fixed-shape independent reference graphs; explicitly non-XLA.
+
+    Eager differentiation across the compiled Kalman value exports unsupported
+    TensorLists. Compiling the whole oracle also fails because TensorFlow's
+    matrix-exponential reverse pass has an unbounded TensorList. This diagnostic
+    therefore traces the existing covariance filter body without its XLA
+    decorator; it neither copies the recursion nor changes the active HMC score.
+    Eight cached shapes are a convenience memory bound, not a numerical setting.
+    """
+
+    def reference_kalman(**kwargs: Any) -> Any:
+        return kalman_filter.python_function(**kwargs, return_filtered=False)[0]
+
+    @tf.function(
+        input_signature=[
+            tf.TensorSpec([PARAMETER_DIM], tf.float64),
+            tf.TensorSpec([time_steps, 2], tf.float64),
+        ],
+        autograph=False,
+        jit_compile=False,
+    )
+    def evaluate(row: Any, observations: Any) -> tuple[Any, Any]:
+        with tf.GradientTape() as tape:
+            tape.watch(row)
+            value = _tf_likelihood_single(
+                row, observations, tf, reference_kalman, include_eigen_check=False
+            )
+        score = tape.gradient(value, row)
+        if score is None:
+            raise Phase9TargetError("reverse-mode oracle score is absent")
+        return value, score
+
+    return evaluate
 
 
