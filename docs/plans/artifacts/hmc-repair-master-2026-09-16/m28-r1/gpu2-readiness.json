{
  "python": "3.13.13",
  "tensorflow": "2.20.0",
  "tfp": "0.25.0",
  "device_scope": "gpu",
  "gpu_intentionally_hidden": false,
  "memory_policy": {
    "schema": "bayesfilter.tensorflow.gpu_memory_policy.v1",
    "mode": "memory_growth",
    "physical_devices": [
      {
        "device": "/physical_device:GPU:0",
        "device_details": {
          "compute_capability": [
            8,
            9
          ],
          "device_name": "NVIDIA GeForce RTX 4080 SUPER"
        },
        "memory_growth": true
      }
    ],
    "all_physical_devices_memory_growth": true,
    "full_device_preallocation_disabled": true,
    "memory_growth_is_hard_memory_cap": false,
    "logical_device_memory_limit_required_for_hard_cap": true,
    "configured_before_logical_device_initialization": true,
    "tf_force_gpu_allow_growth": "true"
  },
  "jit_compile": true,
  "tf32": true,
  "cpu_threads": {
    "intra_op": "1",
    "inter_op": "1"
  },
  "visible_devices": "2",
  "gpu_tensor_device": "/job:localhost/replica:0/task:0/device:GPU:0",
  "physical_gpu_details": [
    {
      "name": "/physical_device:GPU:0",
      "details": {
        "compute_capability": [
          8,
          9
        ],
        "device_name": "NVIDIA GeForce RTX 4080 SUPER"
      }
    }
  ]
}
